{
    "name": "markdown-exporter",
    "version": "1.0.0",
    "description": "Markdown to PDF exporter that runs entirely in the browser.",
    "type": "module",
    "license": "MIT",
    "author": "richie-rich90454",
    "keywords": [
        "markdown",
        "pdf",
        "exporter",
        "solidjs",
        "offline"
    ],
    "packageManager": "pnpm@12.10.1",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:test": "vite build --mode e2e",
        "preview": "vite preview",
        "preview:test": "vite preview --port 4173 --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@mermaid-js/mermaid-zenuml": "0.1.0",
        "katex": "^0.19.1",
        "mermaid": "^12.2.0",
        "rehype-highlight": "^7.0.2",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gemoji": "^8.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "solid-js": "^1.9.17",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@types/hast": "^3.0.5",
        "@types/node": "^26.6.5",
        "axe-core": "^4.14.0",
        "eslint": "^10.12.0",
        "eslint-plugin-solid": "^0.18.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "oxfmt": "^0.72.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^5.0.3"
    }
}
